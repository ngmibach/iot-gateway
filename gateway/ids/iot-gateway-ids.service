[Unit]
Description=IoT Gateway intrusion detection service
After=network-online.target iot-gateway-agent.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Environment=IOTGW_AGENT_DATA=/var/lib/iot-gateway-agent
WorkingDirectory=/opt/iot-gateway-agent/ids
ExecStart=/opt/iot-gateway-agent/ids-venv/bin/python -m ids_gateway.main --config /var/lib/iot-gateway-agent/ids_config.yaml
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/iot-gateway-agent/logs

[Install]
WantedBy=multi-user.target
