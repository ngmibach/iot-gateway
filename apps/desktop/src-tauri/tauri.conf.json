{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IoT Gateway Monitor",
  "version": "0.1.0",
  "identifier": "com.iotgateway.monitor",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:9138/wizard.html",
    "beforeDevCommand": "PYTHONPATH=..:../../control-service python -m shell --start-services --no-browser",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "IoT Gateway Monitor",
        "width": 1100,
        "height": 800,
        "resizable": true,
        "url": "splash.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "msi", "nsis"],
    "icon": [
      "icons/icon.png"
    ],
    "resources": [
      "../shell",
      "../ui",
      "../requirements.txt",
      "../../control-service"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": ["python3"]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "createDesktopShortcut": "always",
        "createStartMenuShortcut": true
      }
    },
    "longDescription": "Double-click desktop app: Setup Wizard, Actions, native Monitoring, Lab, and Admin Code Signing. Starts local Python control services automatically.",
    "shortDescription": "IoT Gateway Monitor — clickable desktop control plane"
  },

  "plugins": {
    "shell": {
      "open": true
    }
  }
}
